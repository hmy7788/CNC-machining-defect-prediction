* text=auto eol=lf

*.csv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.pdf -text -diff

# Notebooks: force a merge conflict instead of silently corrupting output
# cells when two people (or two agent sessions) edit the same notebook.
*.ipynb merge=binary
